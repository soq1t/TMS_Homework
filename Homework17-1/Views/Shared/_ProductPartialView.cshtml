@model Product

@{   
    
        <div class="flex-column">
            <h5>@Model.Name</h5>
            <p>Стоимость: <b>@Model.Price</b>, Количество на складе: <b>@Model.Amount</b></p>            
            <div class="flex-">
            <form action="/product/@Model.Id/modify" method="get">
                <button class="btn-primary" type="submit">Редактировать товар</button>
            </form>            
            @using (Html.BeginForm("remove", "product", Model, FormMethod.Post))
            {
                <button class="btn-danger" type="submit">Удалить товар</button>
            }
            </div>
        </div>    
    
}
