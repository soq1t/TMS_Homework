@model Product

@{
    
    <form action="api/products/@Model.Id/delete" method="post">
        <div class="flex-container">
            <h5>@Model.Name</h5>
            <p>Стоимость: <b>@Model.Price</b></p>
            <p>Количество на складе: <b>@Model.Amount</b></p>
            <div>
                <button class="btn-secondary" type="submit">Remove</button>
            </div>
        </div>
    </form>
    
}
