@{
    ViewData["Title"] = "Главная страница";
}
@model List<Product>

<div class="text-center">
    <h3 class="display-4">Добро пожаловать на склад!</h3>
    <p>В данный момент на складе находится @Model.Count товаров!</p>
    <div>
        @{
            foreach(Product product in Model)
            {
                await Html.RenderPartialAsync("_ProductPartialView", product);
            }
        }
    </div>
</div>
